# ============================================================
# OtoStok — Contoh environment variables
# Copy file ini ke .env lalu sesuaikan nilainya.
# ============================================================

# --- DATABASE (pilih SATU sesuai lingkungan) ---

# Lokal / sandbox (SQLite — default prisma/schema.prisma):
DATABASE_URL=file:/absolute/path/to/db/custom.db

# Produksi Vercel + Supabase (PostgreSQL — otomatis memakai
# prisma/schema.postgres.prisma via scripts/prisma-generate.sh).
# Ambil dari Supabase Dashboard → Project Settings → Database →
# "Connection string → URI" (gunakan mode Connection pooling / port 6543
# untuk app runtime; tambahkan ?pgbouncer=true):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# --- Super Admin ---
# Master key untuk halaman & API /super-admin (wajib sama dengan
# yang dimasukkan di halaman /super-admin):
SUPER_ADMIN_SECRET=ganti_dengan_kunci_rahasia_anda

# --- Landing Page (CTA WhatsApp Sales) ---
# Nomor WhatsApp sales tujuan semua tombol CTA di landing page.
# Format internasional tanpa "+". Kosongkan untuk memakai fallback
# default di src/lib/constants.ts
NEXT_PUBLIC_SALES_WHATSAPP=6281234567890

# --- CATATAN ---
# Akses DATABASE berjalan via Prisma memakai DATABASE_URL di atas (bukan
# supabase-js). SUPABASE_SERVICE_ROLE_KEY hanya dipakai untuk STORAGE
# (lihat bagian Supabase Storage di bawah) — bukan untuk database.

# --- Supabase Storage (WAJIB di produksi Vercel agar upload foto bekerja) ---
# Filesystem serverless Vercel read-only — upload logo/header/foto unit/KTP
# wajib disimpan ke Supabase Storage. Ambil dari Supabase Dashboard →
# Project Settings → API:
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   (service_role — JANGAN pernah ekspos ke klien)
#
# Bucket dibuat OTOMATIS saat upload pertama (lihat src/lib/storage.ts):
#   • otostok-media (PUBLIC) — logo, foto header, foto unit katalog
#   • otostok-ktp   (PRIVATE) — foto KTP rekanan (dibaca via endpoint aman)
# Tanpa kedua env ini (dev lokal), file otomatis disimpan ke disk:
#   public/uploads/ dan upload/ktp/
